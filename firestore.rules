rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Only the admin email can write content.
    function isAdmin() {
      return signedIn() && (request.auth.token.email == 'sakthivelvenket26@gmail.com' || request.auth.token.email == 'kenacademy7@gmail.com');
    }


    // 1. Users can only read and write their OWN user document, admins can read all
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();

      match /mock_attempts/{attemptId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }

    // 2. Mock Tests Collection
    match /mockTests/{id} {
      allow create, update, delete: if isAdmin();
      allow read: if true;
    }

    // 3. Uploads (Study Materials)
    match /uploads/{id} {
      allow create, update, delete: if isAdmin();
      allow read: if true;
    }

    // 4. Notifications
    match /notifications/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 5. Admissions (Leads)
    match /admissions/{id} {
      allow create: if true; // Anyone can submit an inquiry / lead
      allow read, update, delete: if true; // Admin and app can view and manage leads
    }

    // 6. Global Settings (Promo Banner, Pricing Plans, Coupons)
    match /settings/{id} {
      allow read: if true; // Publicly readable on all devices and visitors
      allow write: if true; // Admin updates settings from admin panel
    }
  }
}
