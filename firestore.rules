rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Only the admin email can write content.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'sakthivelvenket26@gmail.com';
    }

    // Helper function: Check if the current user has premium/paid status
    function isPremium() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && (
        get(userPath).data.access != 'payment_required' || 
        get(userPath).data.paid == true || 
        get(userPath).data.premium == true
      );
    }

    // 1. Users can only read and write their OWN user document, admins can read all
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // 2. Mock Tests Collection
    match /mockTests/{id} {
      allow create, update, delete: if isAdmin();
      allow read: if signedIn() && (
        resource.data.isFree == true || isPremium() || isAdmin()
      );
    }

    // 3. Uploads (Study Materials)
    match /uploads/{id} {
      allow create, update, delete: if isAdmin();
      allow read: if signedIn() && (
        resource.data.isFree == true || isPremium() || isAdmin()
      );
    }

    // 4. Notifications
    match /notifications/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
