# ------------------------------------------------------------------
# SHAKTHI ACADEMY — Firebase configuration
#
# To connect the app to your own Firebase project:
#   1. Copy this file and rename it to  .env
#   2. Fill in the values below (from Firebase Console → Project settings
#      → General → Your apps → Web app → SDK setup and configuration).
#   3. Enable Authentication → Email/Password AND Google sign-in.
#
# Leave empty (or delete .env) to keep running in DEMO mode.
# ------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# The admin email(s) that can access the /admin panel.
# Comma-separate multiple emails if needed. All other users are students.
VITE_ADMIN_EMAILS=admin@shakthi.academy

# ------------------------------------------------------------------
# LLM API Keys — AI Mock Test Generator & PDF Question Extractor
#
# The app uses these automatically for:
#   • AI Mock Test generation (Past 5-Year PYQ style)
#   • PDF Question Paper upload & extraction
#
# Get a FREE OpenRouter key: https://openrouter.ai/keys
# ------------------------------------------------------------------
VITE_OPENROUTER_API_KEY=your-openrouter-api-key
VITE_OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Other providers (optional, uncomment if needed):
# VITE_GEMINI_API_KEY=your-gemini-api-key
# VITE_OPENAI_API_KEY=your-openai-api-key
# VITE_DEEPSEEK_API_KEY=your-deepseek-api-key
