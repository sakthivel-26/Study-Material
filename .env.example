# Firebase configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Comma-separated administrator email addresses
VITE_ADMIN_EMAILS=admin@example.com

# AI extraction providers (configure only the providers you use)
VITE_HUGGINGFACE_API_KEY=your-huggingface-token
VITE_HUGGINGFACE_MODEL=your-inference-provider-model-id
VITE_OPENROUTER_API_KEY=your-openrouter-api-key
VITE_OPENROUTER_MODEL=openrouter/free
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GROQ_API_KEY=your-groq-api-key
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_DEEPSEEK_API_KEY=your-deepseek-api-key
